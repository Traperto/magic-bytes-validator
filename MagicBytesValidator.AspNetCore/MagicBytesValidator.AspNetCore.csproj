<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>MagicBytesValidator.AspNetCore</PackageId>
        <Title>MagicBytesValidator.AspNetCore</Title>
        <Description>ASP.NET Core integration for MagicBytesValidator: validate uploaded IFormFiles based on mime types, file extensions and magic byte sequences.</Description>
        <PackageTags>mime mimetype mimetypes magic magicbyte magicbytes extension extensions file
            fileextension aspnetcore iformfile upload trapertoGmbH + TobiasJanssen
        </PackageTags>

        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MagicBytesValidator\MagicBytesValidator.csproj"/>
    </ItemGroup>

</Project>
